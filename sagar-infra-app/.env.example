# Sagar Infra mobile app public API URL.
# Recommended format: backend origin only, without /api.
# The app automatically appends exactly one /api.

# Local Android physical phone example:
# 1. Start the backend on your computer, usually port 5000.
# 2. Find your Windows LAN IPv4 address with: ipconfig
# 3. Use that IPv4 address here. Do not use localhost on a physical phone.
EXPO_PUBLIC_API_URL=http://10.213.45.167:5000

# Production deployed backend example:
# Use your verified public HTTPS backend origin for production builds.
# Do not use a LAN IP, localhost, or a placeholder URL in production.
# EXPO_PUBLIC_API_URL=https://your-production-backend.com

# Also accepted, but not recommended because the app already appends /api:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
