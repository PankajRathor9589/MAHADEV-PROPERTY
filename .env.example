NODE_ENV=development
PORT=5000

# Frontend/API URLs
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=https://www.sagar-infra.in
VITE_API_URL=http://localhost:5000/api

# Database and authentication
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sagar-infra
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Secure admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_EXPIRES_IN=8h
ADMIN_SESSION_NAME=Sagar Infra Admin
ADMIN_SESSION_EMAIL=admin@sagarinfra.local
ADMIN_SESSION_PHONE=7692016188

# Production image storage. If omitted locally, files are stored in /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sagar-infra/properties
MAX_FILE_SIZE_MB=5
MAX_MEDIA_FILE_SIZE_MB=20
